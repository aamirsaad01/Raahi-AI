# Copy this to .env and fill your local values

# PostgreSQL
DB_NAME=raahi_ai
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# OpenAI — used by poi_pipeline AND itinerary RAG agent when key is set
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: force enricher — openai | ollama (default: auto = OpenAI if key set)
# POI_ENRICHER=openai

# Local fallback (if not using OpenAI)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest

# Geoapify — used by poi_pipeline for POI collection (replaces Overpass)
# Free tier: https://myprojects.geoapify.com
# Flutter itinerary map (tiles + routing): use the same key at build time, e.g.
#   flutter run --dart-define=GEOAPIFY_API_KEY=your_key_here
GEOAPIFY_API_KEY=d56b2cc5a2ac43f5bab52ecda0143a19

# POI photos (optional)
# UNSPLASH_ACCESS_KEY=